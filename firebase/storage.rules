rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper: Validates file is an image under 5MB
    function isImage() {
      return request.resource.contentType.matches('image/.*') 
        && request.resource.size < 5 * 1024 * 1024;
    }

    // User Avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && isImage();
    }

    // Article Cover Images
    match /covers/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && isImage();
    }
  }
}